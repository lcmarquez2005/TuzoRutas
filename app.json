{
  "expo": {
    "name": "TuzoRutas",
    "slug": "tuzorutas",
    "version": "1.0.0",

    "web": {
      "favicon": "./src/assets/favicon.png"
    },

    "experiments": {
      "tsconfigPaths": true
    },

    "plugins": [],

    "orientation": "portrait",
    "icon": "./src/assets/icon.png",

    "userInterfaceStyle": "light",

    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "extra": {
      "eas": {
        "projectId": "5c537edc-30b1-4881-9a74-c99e5b5a4866"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.lcmarquez.tuzorutas",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    }
  }
}
